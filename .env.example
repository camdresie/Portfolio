# Copy to .env for local development (the .env file is git-ignored).
# In production these live in Azure App Service > Configuration > Application settings.

# --- Currently Consuming page ---------------------------------------------------------------
GOODREADS_USER_ID=
LETTERBOXD_USERNAME=
LASTFM_API_KEY=
LASTFM_USERNAME=

# --- Desert Horology Co. page: optional self-updating "Latest posts" section -----------------
# Leave INSTAGRAM_ACCESS_TOKEN empty to hide the section entirely.
# Setup walkthrough: docs/instagram-feed-setup.md
INSTAGRAM_ACCESS_TOKEN=

# Where the auto-refreshed token is stored so it survives restarts and deployments.
# Defaults: data/instagram-token.json locally, $HOME/data/instagram-token.json on Azure App Service.
# INSTAGRAM_TOKEN_FILE=

# How many recent posts to show (1-50) and how long to cache them, in minutes.
# INSTAGRAM_FEED_LIMIT=9
# INSTAGRAM_CACHE_TTL_MINUTES=360

# "Most watched" ranking: how many recent posts to consider (10-100) and how many videos to show (1-24).
# INSTAGRAM_RANK_POOL=60
# INSTAGRAM_TOP_LIMIT=6
